# Logs
logs
*.log
npm-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
build
*.local

# Python
python/.venv/
__pycache__/
*.py[cod]
*.spec

# Generated test fixtures (rebuild with: python tests/make_fixtures.py)
tests/fixtures/

# Bundled binaries
src-tauri/bin/audiosync-cli*
src-tauri/resources/ffmpeg/*
!src-tauri/resources/ffmpeg/.gitkeep
src-tauri/target/
src-tauri/gen/

# Editor scratch space (session screenshots, transcript images)
.nimbalyst/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# TypeScript incremental build info
*.tsbuildinfo

# Updater signing keys - never commit these
*.key
*.key.pub
